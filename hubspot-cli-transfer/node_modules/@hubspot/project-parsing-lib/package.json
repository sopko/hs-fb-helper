{
    "name": "@hubspot/project-parsing-lib",
    "version": "0.23.7",
    "description": "Parsing library for converting projects directory structures to their intermediate representation",
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        "./constants": {
            "types": "./src/exports/constants.d.ts",
            "import": "./src/exports/constants.js",
            "default": "./src/exports/constants.js"
        },
        "./lang": {
            "types": "./src/exports/lang.d.ts",
            "import": "./src/exports/lang.js",
            "default": "./src/exports/lang.js"
        },
        "./migrate": {
            "types": "./src/exports/migrate.d.ts",
            "import": "./src/exports/migrate.js",
            "default": "./src/exports/migrate.js"
        },
        "./profiles": {
            "types": "./src/exports/profiles.d.ts",
            "import": "./src/exports/profiles.js",
            "default": "./src/exports/profiles.js"
        },
        "./projects": {
            "types": "./src/exports/projects.d.ts",
            "import": "./src/exports/projects.js",
            "default": "./src/exports/projects.js"
        },
        "./schema": {
            "types": "./src/exports/schema.d.ts",
            "import": "./src/exports/schema.js",
            "default": "./src/exports/schema.js"
        },
        "./themes": {
            "types": "./src/exports/themes.d.ts",
            "import": "./src/exports/themes.js",
            "default": "./src/exports/themes.js"
        },
        "./transform": {
            "types": "./src/exports/transform.d.ts",
            "import": "./src/exports/transform.js",
            "default": "./src/exports/transform.js"
        },
        "./translate": {
            "types": "./src/exports/translate.d.ts",
            "import": "./src/exports/translate.js",
            "default": "./src/exports/translate.js"
        },
        "./uid": {
            "types": "./src/exports/uid.d.ts",
            "import": "./src/exports/uid.js",
            "default": "./src/exports/uid.js"
        },
        "./validation": {
            "types": "./src/exports/validation.d.ts",
            "import": "./src/exports/validation.js",
            "default": "./src/exports/validation.js"
        },
        "./workspaces": {
            "types": "./src/exports/workspaces.d.ts",
            "import": "./src/exports/workspaces.js",
            "default": "./src/exports/workspaces.js"
        }
    },
    "typesVersions": {
        "*": {
            "constants": [
                "./src/exports/constants.d.ts"
            ],
            "lang": [
                "./src/exports/lang.d.ts"
            ],
            "migrate": [
                "./src/exports/migrate.d.ts"
            ],
            "profiles": [
                "./src/exports/profiles.d.ts"
            ],
            "projects": [
                "./src/exports/projects.d.ts"
            ],
            "schema": [
                "./src/exports/schema.d.ts"
            ],
            "themes": [
                "./src/exports/themes.d.ts"
            ],
            "transform": [
                "./src/exports/transform.d.ts"
            ],
            "translate": [
                "./src/exports/translate.d.ts"
            ],
            "uid": [
                "./src/exports/uid.d.ts"
            ],
            "validation": [
                "./src/exports/validation.d.ts"
            ],
            "workspaces": [
                "./src/exports/workspaces.d.ts"
            ]
        }
    },
    "devDependencies": {
        "@hubspot/npm-scripts": "^0.3.3",
        "@inquirer/prompts": "^7.1.0",
        "@types/node": "^24.9.0",
        "@types/npm-packlist": "7.0.3",
        "@types/npmcli__map-workspaces": "3.0.4",
        "@types/semver": "^7.5.8",
        "@typescript-eslint/eslint-plugin": "8.54.0",
        "@typescript-eslint/parser": "8.54.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.38.0",
        "eslint-plugin-import": "^2.31.0",
        "husky": "^9.1.7",
        "lint-staged": "^10.5.4",
        "prettier": "^3.3.0",
        "semver": "^7.6.3",
        "tsx": "^4.20.5",
        "typescript": "^5.6.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@hubspot/local-dev-lib": "5.14.0",
        "@npmcli/map-workspaces": "4.0.2",
        "ajv": "8.18.0",
        "ajv-formats": "3.0.1",
        "glob": "13.0.0",
        "npm-packlist": "8.0.1"
    },
    "resolutions": {
        "rollup": "4.64.1",
        "ajv-formats/ajv": "8.18.0",
        "vite": "^6.0.0"
    },
    "overrides": {
        "rollup": "4.64.1",
        "ajv-formats": {
            "ajv": "8.18.0"
        },
        "vite": "^6.0.0"
    },
    "scripts": {
        "build": "tsx ./scripts/build.ts",
        "lint": "echo 'Linting is disabled for Blazar'",
        "lint:local": "eslint --max-warnings=0 . && prettier ./src/** --check",
        "local-dev": "yarn build && cd dist && yarn link && cd .. && tsc --watch --rootDir . --outdir dist",
        "local-link": "hubspot-linking",
        "prettier:write": "prettier ./src/** --write",
        "test": "vitest run --coverage",
        "release": "tsx ./scripts/release.ts release",
        "acceptance-test": "yarn --cwd=./acceptance-tests test"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
